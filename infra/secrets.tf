# Legacy host credentials: SecureString, read by the gateway at cold start and cached.
# (Values generated by Terraform also live in the state file, which is encrypted in S3.)
resource "random_password" "legacy" {
  length  = 32
  special = false
}

resource "random_password" "legacy_admin" {
  length  = 32
  special = false
}

resource "aws_ssm_parameter" "legacy_credentials" {
  name  = "/lrg/${var.stage}/legacy/credentials"
  type  = "SecureString"
  value = jsonencode({ user = "GATEWAY", password = random_password.legacy.result })
}

resource "aws_ssm_parameter" "legacy_admin_token" {
  name  = "/lrg/${var.stage}/legacy/admin-token"
  type  = "SecureString"
  value = random_password.legacy_admin.result
}

# JWT signing key pair for partner tokens (scripts/issue-token.ts signs, the authorizer verifies).
resource "tls_private_key" "jwt" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

resource "aws_ssm_parameter" "jwt_public_key" {
  name  = "/lrg/${var.stage}/auth/public-key"
  type  = "String"
  value = tls_private_key.jwt.public_key_pem
}

resource "aws_ssm_parameter" "jwt_private_key" {
  name  = "/lrg/${var.stage}/auth/private-key"
  type  = "SecureString"
  value = tls_private_key.jwt.private_key_pem_pkcs8
}
