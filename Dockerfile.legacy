# The simulated RESLINK/2 legacy host as a container.
#   docker build -f Dockerfile.legacy -t reslink-legacy .
#   docker run --rm -p 9081:9081 -e LEGACY_ERROR_RATE=0.2 reslink-legacy
#   curl http://localhost:9081/reslink?wsdl
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src
RUN node scripts/build.mjs

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=9081
COPY --from=build /app/dist/legacy-server ./
USER node
EXPOSE 9081
CMD ["node", "index.js"]
